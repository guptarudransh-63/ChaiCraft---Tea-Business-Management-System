{
  "name": "tea-business-platform",
  "version": "1.0.0",
  "description": "Production-Ready Tea Business Management System",
  "scripts": {
    "start": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run start:server\" \"npm run start:client\"",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run dev:server\" \"npm run start:client\"",
    "test": "cd server && npm test",
    "build": "cd client && npm run build",
    "start:server": "cd server && npm start",
    "dev:server": "cd server && npm run dev",
    "seed": "cd server && npm run seed",
    "test:server": "cd server && npm test",
    "start:client": "cd client && npm run dev",
    "build:client": "cd client && npm run build"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  }
}
